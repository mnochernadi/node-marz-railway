# Set these in Railway > Variables
SERVICE_PROTOCOL=rest
SSL_CLIENT_CERT_PEM=<paste the panel's client certificate (PEM)>
SSL_CERT_PEM=<node server certificate (PEM), keep it stable across deploys>
SSL_KEY_PEM=<node server private key (PEM)>
# Optional: limit inbounds to the ones you expose through Railway
# INBOUNDS=VLESS TCP REALITY
